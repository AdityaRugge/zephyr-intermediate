build zephyr/cmake/reports/CMakeFiles/bl2_rom_report | ${cmake_ninja_workdir}zephyr/cmake/reports/CMakeFiles/bl2_rom_report: CUSTOM_COMMAND || modules/trusted-firmware-m/tfm modules/trusted-firmware-m/tfm_cmake
  COMMAND = cd /opt/zephyr-ws/secure-boot-app/build-upg-v2 && /opt/venv/bin/python3 /opt/zephyr-ws/zephyr/scripts/footprint/size_report -k /opt/zephyr-ws/secure-boot-app/build-upg-v2/tfm/bin/bl2.elf -z /opt/zephyr-ws/zephyr -o /opt/zephyr-ws/secure-boot-app/build-upg-v2 --workspace=/opt/zephyr-ws -d 99 rom
  pool = console


#############################################
# Custom command for zephyr/cmake/reports/CMakeFiles/bl2_footprint

build zephyr/cmake/reports/CMakeFiles/bl2_footprint | ${cmake_ninja_workdir}zephyr/cmake/reports/CMakeFiles/bl2_footprint: CUSTOM_COMMAND || modules/trusted-firmware-m/tfm modules/trusted-firmware-m/tfm_cmake
  COMMAND = cd /opt/zephyr-ws/secure-boot-app/build-upg-v2 && /opt/venv/bin/python3 /opt/zephyr-ws/zephyr/scripts/footprint/size_report -k /opt/zephyr-ws/secure-boot-app/build-upg-v2/tfm/bin/bl2.elf -z /opt/zephyr-ws/zephyr -o /opt/zephyr-ws/secure-boot-app/build-upg-v2 --workspace=/opt/zephyr-ws -d 99 all -q
  pool = console

