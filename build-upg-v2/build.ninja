  COMMAND = cd /opt/zephyr-ws/secure-boot-app/build-upg-v2 && /usr/bin/cmake -DBINARY_DIR=/opt/zephyr-ws/secure-boot-app/build-upg-v2 -DSOURCE_DIR=/opt/zephyr-ws/secure-boot-app/app/upgrade_probe -P /opt/zephyr-ws/zephyr/cmake/pristine.cmake

