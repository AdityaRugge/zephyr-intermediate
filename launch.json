{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "cwd": "${workspaceFolder}",
            "executable": "${workspaceFolder}/build/zephyr/zephyr.elf",
            "name": "Debug STM32F446RE with ST-Link",
            "request": "launch",
            "type": "cortex-debug",
            "gdbPath": "${env:HOME}/zephyr-sdk-1.0.1/gnu/arm-zephyr-eabi/bin/arm-zephyr-eabi-gdb",
            "servertype": "openocd",
            "serverpath": "${env:HOME}/zephyr-sdk-1.0.1/hosttools/usr/bin/openocd",
            "searchDir": [
                "${env:HOME}/zephyr-sdk-1.0.1/hosttools/opt/openocd/share/openocd/scripts"
            ],
            "configFiles": [
                "interface/stlink.cfg",
                "target/stm32f4x.cfg"
            ],
            "runToEntryPoint": "main",
            "showDevDebugOutput": "raw",
        }
    ]
}